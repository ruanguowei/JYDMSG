page {
  background-color: #f9fafb;
}

.home-content {
  padding: 24rpx 24rpx 32rpx;
}

.banner {
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner swiper {
  width: 100%;
  height: 100%;
}

.banner image {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-image-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #edf0f3;
  color: #87909a;
  font-size: 26rpx;
}

.banner .banner-image {
  opacity: 0;
}

.banner .banner-image.is-loaded {
  opacity: 1;
}

.banner-placeholder {  width: 100%;  height: 100%;}.empty-banner {  width: 100%;  height: 100%;  background-color: #ffffff;  border-radius: 8rpx;}

.quick-actions {
  display: flex;
  padding: 16rpx 8rpx;
  margin: 24rpx 0;
  background-color: #fff;
  border-radius: 20rpx;
}

.quick-action-item {
  flex: 1;
  min-width: 0;
  min-height: 176rpx;
  box-sizing: border-box;
  border-right: 1rpx solid #eef1f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 4rpx;
}

.quick-action-item:last-child {
  border-right: none;
}

.quick-action-pressed {
  background-color: #f4f7fb;
}

.quick-action-icon {
  width: 56rpx;
  height: 56rpx;
  background: transparent;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.quick-action-icon .iconfont {
  font-size: 48rpx;
  color: #6366f1;
}

.quick-action-icon .icon-image {
  width: 56rpx;
  height: 56rpx;
  object-fit: contain;
}

.quick-action-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.45;
  text-align: center;
}

.notice-board {
  background: #fff;
  padding: 28rpx;
  border-radius: 20rpx;
}

.notice-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  border-left: 4rpx solid #3a7eff;
  padding-left: 16rpx;
}

.notice-list {
  padding: 0;
}

.notice-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 44px;
  padding: 24rpx 0;
  box-sizing: border-box;
  border-bottom: 1px solid #f0f0f0;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-item-pressed {
  background-color: #f7f9fc;
}

.notice-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #3a7eff;
  flex-shrink: 0;
}

.notice-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.notice-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-right: 4rpx;
  border-top: 2rpx solid #a4acb7;
  border-right: 2rpx solid #a4acb7;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.notice-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 44px;
  margin-top: 8rpx;
  border-top: 1rpx solid #eef1f5;
  color: #4b6bfb;
  font-size: 26rpx;
}

.notice-more-pressed {
  background-color: #f4f7fb;
}

.notice-more-arrow {
  width: 10rpx;
  height: 10rpx;
  margin-top: -6rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.notice-more-arrow.is-expanded {
  margin-top: 6rpx;
  transform: rotate(225deg);
}

.notice-empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #3498db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 公告详情弹窗 */
.notice-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.notice-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4rpx);
}

.notice-modal-content {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  max-height: 80%;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  z-index: 1001;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.notice-modal-header {
  padding: 40rpx 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 2rpx solid #f5f5f5;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
}

.notice-modal-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #2c3e50;
  flex: 1;
  padding-right: 20rpx;
  line-height: 1.4;
  word-break: break-all;
}

.notice-modal-close {
  font-size: 44rpx;
  color: #95a5a6;
  line-height: 1;
  padding: 8rpx;
  border-radius: 50%;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.notice-modal-close:active {
  background-color: #ecf0f1;
  color: #7f8c8d;
}

.notice-modal-body {
  padding: 40rpx;
  overflow-y: auto;
  flex: 1;
}

.notice-modal-time {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 30rpx;
  padding: 16rpx 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border-left: 6rpx solid #3498db;
  display: flex;
  align-items: center;
}

.notice-modal-time::before {
  content: "📅";
  margin-right: 12rpx;
  font-size: 24rpx;
}

.notice-modal-text {
  font-size: 32rpx;
  color: #34495e;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
  text-align: justify;
}

/* 富文本内容样式 */
.notice-modal-content-rich {
  font-size: 32rpx;
  color: #34495e;
  line-height: 1.8;
}

.notice-modal-content-rich .section {
  margin-bottom: 30rpx;
}

.notice-modal-content-rich .section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #e9ecef;
}

.notice-modal-content-rich .section-content {
  font-size: 30rpx;
  color: #495057;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.notice-modal-content-rich .highlight {
  background-color: #fff3cd;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.notice-modal-content-rich .contact-info {
  background-color: #e8f4fd;
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #3498db;
  margin-top: 20rpx;
}

.notice-modal-content-rich .contact-info .phone {
  color: #2980b9;
  font-weight: 500;
  text-decoration: none;
}

/* PDF文件样式 */
.pdf-section {
  margin-top: 30rpx;
}

.pdf-list {
  margin-top: 16rpx;
}

.pdf-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.pdf-item:active {
  background-color: #e9ecef;
  transform: scale(0.98);
}

.pdf-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pdf-info {
  flex: 1;
  min-width: 0;
}

.pdf-name {
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: 500;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pdf-size {
  font-size: 24rpx;
  color: #7f8c8d;
}

.pdf-warning {
  font-size: 22rpx;
  color: #e67e22;
  margin-top: 6rpx;
  padding: 4rpx 8rpx;
  background-color: #fdf2e9;
  border-radius: 6rpx;
  border-left: 3rpx solid #e67e22;
  display: inline-block;
}

.pdf-action {
  font-size: 26rpx;
  color: #3498db;
  font-weight: 500;
  padding: 8rpx 16rpx;
  background-color: #e8f4fd;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 其他附件样式 */
.attachment-section {
  margin-top: 30rpx;
}

.attachment-list {
  margin-top: 16rpx;
}

.attachment-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.attachment-item:active {
  background-color: #e9ecef;
  transform: scale(0.98);
}

.attachment-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.attachment-info {
  flex: 1;
  min-width: 0;
}

.attachment-name {
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: 500;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attachment-type {
  font-size: 24rpx;
  color: #7f8c8d;
}

.attachment-action {
  font-size: 26rpx;
  color: #27ae60;
  font-weight: 500;
  padding: 8rpx 16rpx;
  background-color: #e8f5e8;
  border-radius: 8rpx;
  flex-shrink: 0;
}
