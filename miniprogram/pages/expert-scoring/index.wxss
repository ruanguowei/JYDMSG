/* 作品展示与评审首屏；下方采用美术馆作品标签排版。 */
page { background: #f6f5f2; color: #252a30; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.review-page { padding: 12rpx 0 calc(124rpx + env(safe-area-inset-bottom)); }
/* 总分卡片留出操作空间，小屏可滚动，避免作品图被挤到不可见。 */
.media-card { position: relative; width: calc(100% - 40rpx); max-width: 44vh; min-width: 420rpx; margin: 0 auto; background: #eeece7; border-radius: 18rpx; overflow: hidden; }
/* 百分比占位随宽度生成等高容器，屏幕变矮时也保持 1:1。 */
.media-card::before { content: ""; display: block; padding-top: 100%; }
.media-card > .media-swiper, .media-card > .single-media, .media-card > .main-video, .media-card > .empty-media { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.media-swiper, .media-slide, .main-image, .main-video { display: block; width: 100%; height: 100%; }
.video-card { max-width: none; height: 32vh; min-height: 300rpx; background: #15171a; }
.video-card::before { display: none; }
.empty-media { height: 100%; display: flex; align-items: center; justify-content: center; font-size: 23rpx; color: #777c82; }
.thumb-strip { display: block; margin: 12rpx 20rpx 0; width: calc(100% - 40rpx); height: 80rpx; white-space: nowrap; }
.thumb-item { box-sizing: border-box; display: inline-block; vertical-align: top; position: relative; width: calc((100% - 48rpx) / 7); margin-right: 8rpx; border: 2rpx solid transparent; border-radius: 8rpx; overflow: hidden; background: #e9e7e2; }
.thumb-item:last-child { margin-right: 0; }
.thumb-item.active { border-color: #0866ff; color: #0866ff; }
.thumb-item.active .thumb-label { background: #edf4ff; font-weight: 600; }
.thumb-item image, .thumb-placeholder { width: 100%; height: 48rpx; display: block; }
.thumb-label { background: #fff; font-size: 19rpx; line-height: 28rpx; text-align: center; overflow: hidden; text-overflow: ellipsis; }
.thumb-check { position: absolute; right: 2rpx; top: 2rpx; width: 20rpx; height: 20rpx; line-height: 20rpx; text-align: center; border-radius: 50%; background: #0866ff; color: white; font-size: 15rpx; }
.score-card { margin: 14rpx 20rpx 0; padding: 6rpx 24rpx 0; border: 1rpx solid #e8e7e3; border-radius: 18rpx; background: #fff; overflow: hidden; }
.score-row { display: flex; align-items: center; min-height: 70rpx; padding: 2rpx 0; border-bottom: 1rpx solid #f0efec; }
.score-name { width: 184rpx; flex-shrink: 0; font-size: 25rpx; font-weight: 500; line-height: 36rpx; }
.score-value { width: 80rpx; flex-shrink: 0; text-align: right; color: #0866ff; font-size: 29rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.score-unit { font-size: 20rpx; color: #85898e; font-weight: 400; }
.score-scale { flex: 1; min-width: 0; padding: 0 12rpx 0 4rpx; }
.score-slider { margin: 6rpx 12rpx 0; height: 30rpx; }
.scale-labels { display: flex; justify-content: space-between; margin: 0 12rpx; line-height: 24rpx; }
.scale-label { width: 44rpx; margin: 0 -22rpx; text-align: center; font-size: 19rpx; color: #92969d; }
.scale-label.active { color: #0866ff; font-weight: 600; }
.deduction-block { padding: 8rpx 0 2rpx; }
.deduction-block checkbox-group { display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; }
.deduction-chip, .disqualify-item { display: flex; align-items: center; font-size: 22rpx; color: #696c73; min-height: 44rpx; line-height: 32rpx; }
checkbox { transform: scale(.75); transform-origin: left center; width: 42rpx; }
.disqualify-card { padding: 0 0 6rpx; }
.disqualify-item { color: #bf4545; }
.score-summary { display: flex; align-items: center; gap: 16rpx; margin: 0 -24rpx; padding: 12rpx 24rpx; line-height: 36rpx; border-top: 1rpx solid #e4ecf7; background: #f3f7fd; font-size: 23rpx; color: #747780; }
.summary-final { margin-left: auto; color: #0866ff; font-size: 30rpx; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
.work-info-compact { margin: 24rpx 20rpx; padding: 32rpx 30rpx; background: #fffdf9; border: 1rpx solid #e7e2d8; border-radius: 14rpx; }
.info-eyebrow { display: flex; align-items: center; gap: 14rpx; color: #92816b; font-size: 21rpx; letter-spacing: 5rpx; }
.info-rule { height: 2rpx; width: 40rpx; background: #b09b80; }
.compact-title { margin: 18rpx 0 26rpx; font-family: "Songti SC", "SimSun", serif; font-size: 38rpx; font-weight: 600; line-height: 1.5; overflow-wrap: break-word; }
.work-facts { border-top: 1rpx solid #e9e3d9; border-bottom: 1rpx solid #e9e3d9; padding: 10rpx 0; }
.work-fact { display: flex; align-items: baseline; padding: 12rpx 0; line-height: 1.65; font-size: 24rpx; }
.fact-label { flex-shrink: 0; width: 132rpx; color: #928879; }
.fact-value { flex: 1; min-width: 0; color: #424440; overflow-wrap: break-word; }
.dimension-line + .dimension-line { margin-top: 6rpx; }
.work-statement { padding-top: 24rpx; }
.statement-label { color: #928879; font-size: 22rpx; letter-spacing: 2rpx; }
.compact-desc { font-size: 25rpx; line-height: 1.9; color: #565a52; margin-top: 14rpx; white-space: pre-wrap; overflow-wrap: break-word; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 14rpx; padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e7e9ed; z-index: 10; }
.bottom-btn { box-sizing: border-box; margin: 0; padding: 0 10rpx; height: 72rpx; line-height: 70rpx; border-radius: 10rpx; font-size: 25rpx; font-weight: 500; }
.bottom-btn::after { border: none; }
.bottom-btn.ghost { flex: 1; color: #0866ff; border: 1rpx solid #c9dafa; background: #f8faff; }
.bottom-btn.primary { flex: 2; color: #fff; background: #0866ff; }
.bottom-btn[disabled] { opacity: .45; }
.loading { min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; color: #747780; font-size: 26rpx; }
.loading-spinner { width: 44rpx; height: 44rpx; border: 4rpx solid #e2e8f2; border-top-color: #0866ff; border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (max-height: 560px) { .thumb-item image, .thumb-placeholder { height: 42rpx; } .thumb-strip { height: 74rpx; } }
@media (min-width: 600px) { .review-page { max-width: 480px; margin: 0 auto; } .media-card { max-width: calc(100vh - 420px - env(safe-area-inset-bottom)); } .video-card { max-width: none; max-height: calc(100vh - 420px - env(safe-area-inset-bottom)); } .thumb-strip { height: 46px; } .thumb-item image, .thumb-placeholder { height: 28px; } .thumb-label { font-size: 11px; line-height: 14px; } .score-row { min-height: 38px; padding: 2px 0; } .score-name { width: 112px; font-size: 15px; } .score-value { width: 48px; font-size: 18px; } .score-slider { height: 18px; margin-top: 3px; } .scale-labels { line-height: 14px; } .scale-label { font-size: 11px; } .score-unit { font-size: 12px; } .deduction-chip, .disqualify-item { min-height: 26px; font-size: 13px; } .score-summary { line-height: 22px; padding: 7px 0; font-size: 13px; } .summary-final { font-size: 16px; } .bottom-bar { padding-left: max(24rpx, calc((100% - 450px) / 2)); padding-right: max(24rpx, calc((100% - 450px) / 2)); } }

.total-score-heading { display:flex; align-items:center; justify-content:space-between; padding:26rpx 26rpx 8rpx; }
.total-score-title { font-size:30rpx; font-weight:600; }.total-score-hint { color:#8a919b; font-size:22rpx; }
.total-score-number { color:#0866ff; font-size:58rpx; font-weight:600; font-variant-numeric:tabular-nums; }.total-score-number text { color:#9299a3; font-size:24rpx; font-weight:400; }
.total-score-slider { margin:24rpx 34rpx 8rpx; }.total-score-ticks { display:flex; justify-content:space-between; margin:0 34rpx; color:#9299a3; font-size:21rpx; }
.score-fine-control { display:flex; align-items:center; justify-content:space-between; padding:22rpx 26rpx; }.score-fine-control text { font-size:22rpx; color:#838b96; }.score-fine-control button { margin:0; padding:0 22rpx; line-height:54rpx; font-size:24rpx; color:#0866ff; background:#f1f6ff; }.score-fine-control button::after { border:none; }
.main-image { object-fit:contain; }
