<!--pages/expert-scoring/index.wxml-->
<view class="scoring-container">
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <view wx:elif="{{submission}}" class="review-page">
    <view class="media-card {{submission.workType === 'video' ? 'video-card' : ''}}">
      <video wx:if="{{submission.workType === 'video' && activeMediaUrl}}" id="review-video" class="main-video" src="{{activeMediaUrl}}" controls object-fit="contain" bindtimeupdate="onVideoTimeUpdate"></video>
      <view wx:elif="{{submission.workType !== 'video' && mediaItems.length === 1}}" class="single-media media-slide" data-url="{{mediaItems[0].url}}" bindtap="previewImage">
        <image wx:if="{{mediaItems[0].thumbnailUrl && !mediaItems[0].thumbnailError}}" class="main-image" src="{{mediaItems[0].thumbnailUrl}}" mode="aspectFit" data-index="0" binderror="onThumbnailError" />
        <view wx:else class="empty-media">缩略图暂不可用 · 点击查看原图</view>
      </view>
      <swiper wx:elif="{{submission.workType !== 'video' && mediaItems.length > 1}}" class="media-swiper" current="{{activeMediaIndex}}" bindchange="onMediaSwipe" autoplay="{{false}}" circular="{{false}}" duration="220">
        <swiper-item wx:for="{{mediaItems}}" wx:key="key">
          <view class="media-slide" data-url="{{item.url}}" bindtap="previewImage">
            <image wx:if="{{item.thumbnailUrl && !item.thumbnailError && (index === activeMediaIndex || (!lowMemory && index >= activeMediaIndex - 1 && index <= activeMediaIndex + 1))}}" class="main-image" src="{{item.thumbnailUrl}}" mode="aspectFit" data-index="{{index}}" binderror="onThumbnailError" />
            <view wx:else class="empty-media">缩略图暂不可用 · 点击查看原图</view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:else class="empty-media">{{submission.workType === 'video' ? '暂无可播放视频' : '暂无作品图片'}}</view>
    </view>

    <scroll-view wx:if="{{submission.workType !== 'video' && mediaItems.length > 0}}" scroll-x class="thumb-strip" enhanced show-scrollbar="{{false}}" scroll-into-view="thumb-{{activeMediaIndex}}" scroll-with-animation>
      <view wx:for="{{mediaItems}}" wx:key="key" id="thumb-{{index}}" class="thumb-item {{activeMediaIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onMediaThumbTap">
        <image wx:if="{{item.smallThumbnailUrl && !item.thumbnailError}}" src="{{item.smallThumbnailUrl}}" mode="aspectFill" data-index="{{index}}" binderror="onThumbnailError"></image>
        <view wx:else class="thumb-placeholder"></view>
        <view wx:if="{{item.viewed}}" class="thumb-check">✓</view>
        <view class="thumb-label">{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="score-card">
      <view class="total-score-heading">
        <view><view class="total-score-title">基础评分</view><text class="total-score-hint">综合评分 · 精确到 0.1 分</text></view>
        <view class="total-score-number">{{baseScoreText}}<text> / 10</text></view>
      </view>
      <slider class="total-score-slider" min="0" max="100" step="1" value="{{scoreTenths}}" activeColor="#0866ff" backgroundColor="#e2e6ec" block-color="#0866ff" block-size="24" disabled="{{submitting || verificationPending}}" bindchanging="onScoreSliderChange" bindchange="onScoreSliderChange" />
      <view class="total-score-ticks"><text>0</text><text>2</text><text>4</text><text>6</text><text>8</text><text>10</text></view>
      <view class="score-fine-control">
        <button data-delta="-1" bindtap="adjustBaseScore" disabled="{{submitting || verificationPending}}">− 0.1</button>
        <text>{{scoreTouched ? '已选择基础分' : '请滑动选择分数'}}</text>
        <button data-delta="1" bindtap="adjustBaseScore" disabled="{{submitting || verificationPending}}">＋ 0.1</button>
      </view>

      <view class="deduction-block">
        <checkbox-group bindchange="onDeductionGroupChange">
          <label class="deduction-chip">
            <checkbox disabled="{{submitting || verificationPending}}" value="aiNotLabeled" checked="{{deductions.aiNotLabeled}}" />
            <text>AI 未标注 -2</text>
          </label>
          <label class="deduction-chip">
            <checkbox disabled="{{submitting || verificationPending}}" value="missingCreativeStatement" checked="{{deductions.missingCreativeStatement}}" />
            <text>缺少说明 -1</text>
          </label>
        </checkbox-group>
      </view>

      <view class="disqualify-card">
        <checkbox-group bindchange="onDisqualifyChange">
          <label class="disqualify-item">
            <checkbox disabled="{{submitting || verificationPending}}" value="disqualify" checked="{{disqualify}}" color="#e74c3c" />
            <text>内容违规或侵权抄袭，取消资格</text>
          </label>
        </checkbox-group>
      </view>

      <view class="score-summary">
        <text>基础分 {{baseScoreText}}</text>
        <text wx:if="{{totalScore > finalScore}}">扣分 {{deductionScore}}</text>
        <text class="summary-final">最终 {{finalScoreText}} 分</text>
      </view>
    </view>

    <view class="work-info-compact">
      <view class="info-eyebrow"><view class="info-rule"></view><text>作品档案</text></view>
      <view class="compact-title">{{submission.artworkName || submission.title}}</view>
      <view class="work-facts">
        <view class="work-fact"><text class="fact-label">创作年份</text><text class="fact-value">{{submission.createYear || '未填写'}}</text></view>
        <view class="work-fact"><text class="fact-label">作品尺寸</text><view class="fact-value">
          <view wx:for="{{dimensionRows}}" wx:key="index" class="dimension-line">{{dimensionRows.length > 1 ? (index + 1) + '. ' : ''}}{{item}}</view>
          <text wx:if="{{!dimensionRows.length}}">{{submission.workType === 'video' ? '不适用（视频作品）' : '未填写'}}</text>
        </view></view>
        <view class="work-fact"><text class="fact-label">工艺材料</text><text class="fact-value">{{submission.craftMaterial || '未填写'}}</text></view>
      </view>
      <view wx:if="{{submission.artworkDescription || submission.description}}" class="work-statement">
        <view class="statement-label">创作说明</view>
        <view class="compact-desc">{{submission.artworkDescription || submission.description}}</view>
      </view>
    </view>

    <view class="bottom-bar">
      <button class="bottom-btn ghost" bindtap="goPreviousWork" disabled="{{submitting}}">返回类别</button>
      <button class="bottom-btn ghost" bindtap="saveDraft" disabled="{{submitting || verificationPending}}">{{draftSaved ? '已暂存' : '暂存'}}</button>
      <button class="bottom-btn primary {{submitting ? 'loading' : ''}}" bindtap="submitScore" disabled="{{submitting || verificationPending}}">
        {{verificationPending ? '核验作品中...' : submitting ? '提交中...' : '提交并下一件'}}
      </button>
    </view>
  </view>
</view>
