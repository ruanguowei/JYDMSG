/* pages/pottery-catalog/index.wxss */
/* 3D翻书效果画册 - 高级版 */

/* ==================== 基础容器 ==================== */
.catalog-container {
  width: 100vw;
  height: 100vh;
  background: radial-gradient(ellipse at center, #1a1a2e 0%, #0a0a14 100%);
  position: relative;
  overflow: hidden;
}

/* ==================== 加载动画 ==================== */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  background: radial-gradient(ellipse at center, #1a1a2e 0%, #0a0a14 100%);
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 翻书加载动画 */
.book-loading {
  width: 100rpx;
  height: 80rpx;
  position: relative;
  perspective: 400rpx;
}

.book-loading .book-page {
  position: absolute;
  width: 50rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
  border-radius: 0 4rpx 4rpx 0;
  transform-origin: left center;
  box-shadow: 2rpx 2rpx 10rpx rgba(0,0,0,0.2);
}

.book-loading .book-page:nth-child(1) {
  left: 50rpx;
  animation: flipPage 1.5s ease-in-out infinite;
}

.book-loading .book-page:nth-child(2) {
  left: 50rpx;
  animation: flipPage 1.5s ease-in-out infinite 0.3s;
}

.book-loading .book-page:nth-child(3) {
  left: 50rpx;
  animation: flipPage 1.5s ease-in-out infinite 0.6s;
}

@keyframes flipPage {
  0%, 100% { transform: rotateY(0deg); }
  50% { transform: rotateY(-180deg); }
}

.loading-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  margin-top: 40rpx;
  letter-spacing: 2rpx;
}

.loading-progress {
  margin-top: 24rpx;
  width: 400rpx;
}

.progress-bar {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #c9a86c, #f0d9a0);
  transition: width 0.3s ease;
  border-radius: 3rpx;
}

.progress-text {
  display: block;
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  margin-top: 12rpx;
}

/* ==================== 3D书本容器 ==================== */
.book-wrapper {
  width: 100%;
  height: calc(100% - 120rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.book-3d {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  perspective: 2000rpx;
}

.flip-container {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

/* ==================== 书页样式 ==================== */
.book-page {
  position: absolute;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.645, 0.045, 0.355, 1);
}

.book-page.right-page {
  transform-origin: left center;
}

.book-page.left-page {
  transform: rotateY(-180deg);
  transform-origin: right center;
}

.book-page.flipping-page {
  transform-origin: left center;
  z-index: 10;
}

.book-page.flipping-page.flip-prev {
  transform-origin: right center;
}

.page-inner {
  width: 100%;
  height: 100%;
  background: #faf8f5;
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: 
    0 0 40rpx rgba(0,0,0,0.3),
    inset 0 0 80rpx rgba(0,0,0,0.05);
  position: relative;
}

/* 页面阴影效果 */
.page-shadow {
  position: absolute;
  top: 0;
  height: 100%;
  width: 60rpx;
  pointer-events: none;
}

.page-shadow.right {
  right: 0;
  background: linear-gradient(to left, 
    rgba(0,0,0,0.15) 0%, 
    rgba(0,0,0,0.05) 30%,
    transparent 100%);
}

.page-shadow.left {
  left: 0;
  background: linear-gradient(to right, 
    rgba(0,0,0,0.2) 0%, 
    rgba(0,0,0,0.05) 30%,
    transparent 100%);
}

/* 翻页卷角效果 */
.page-curl {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, 
    transparent 50%, 
    rgba(0,0,0,0.05) 50%,
    rgba(0,0,0,0.1) 100%);
  border-radius: 0 0 8rpx 0;
  pointer-events: none;
}

/* 书脊效果 */
.book-spine {
  position: absolute;
  left: -10rpx;
  top: 5%;
  width: 20rpx;
  height: 90%;
  background: linear-gradient(90deg, 
    #2a2a3e 0%, 
    #3a3a4e 50%, 
    #2a2a3e 100%);
  border-radius: 4rpx 0 0 4rpx;
  box-shadow: -4rpx 0 10rpx rgba(0,0,0,0.3);
}

/* 翻页动画类 */
.page-inner.page-enter {
  animation: pageEnter 0.5s ease-out;
}

@keyframes pageEnter {
  from {
    opacity: 0;
    transform: translateX(20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 通用页面样式 */
.page {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ===== 封面页 ===== */
.cover-page {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  position: relative;
}

.cover-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
  position: relative;
  z-index: 1;
}

/* 封面装饰角 */
.cover-decoration {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-color: #c9a86c;
  border-style: solid;
  border-width: 0;
}

.cover-decoration.top-left {
  top: 40rpx;
  left: 40rpx;
  border-top-width: 3rpx;
  border-left-width: 3rpx;
}

.cover-decoration.top-right {
  top: 40rpx;
  right: 40rpx;
  border-top-width: 3rpx;
  border-right-width: 3rpx;
}

.cover-decoration.bottom-left {
  bottom: 40rpx;
  left: 40rpx;
  border-bottom-width: 3rpx;
  border-left-width: 3rpx;
}

.cover-decoration.bottom-right {
  bottom: 40rpx;
  right: 40rpx;
  border-bottom-width: 3rpx;
  border-right-width: 3rpx;
}

.cover-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
  padding: 24rpx 40rpx;
  border: 1rpx solid #c9a86c;
  background: rgba(201, 168, 108, 0.08);
}

.logo-text {
  font-size: 28rpx;
  color: #c9a86c;
  font-weight: 500;
  letter-spacing: 6rpx;
}

.logo-text-sub {
  font-size: 32rpx;
  color: #c9a86c;
  font-weight: 600;
  letter-spacing: 12rpx;
  margin-top: 8rpx;
}

.cover-title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.cover-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 12rpx;
  margin-bottom: 24rpx;
}

.cover-title {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 16rpx;
  margin-bottom: 40rpx;
  text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
}

.cover-divider {
  width: 240rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #c9a86c, transparent);
  margin-bottom: 40rpx;
}

.cover-theme {
  font-size: 30rpx;
  color: #c9a86c;
  letter-spacing: 8rpx;
  font-weight: 300;
}

.cover-hint {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.hint-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 4rpx;
}

.cover-hint .cover-year {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 8rpx;
}

/* 翻页提示 */
.flip-hint {
  position: absolute;
  bottom: 200rpx;
  right: 60rpx;
  display: flex;
  align-items: center;
  opacity: 0;
  transition: opacity 0.5s;
}

.flip-hint.show {
  opacity: 1;
  animation: slideHint 1.5s ease-in-out infinite;
}

.hint-hand {
  font-size: 48rpx;
}

.hint-arrow {
  font-size: 32rpx;
  color: #c9a86c;
  margin-left: 10rpx;
}

@keyframes slideHint {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(20rpx); }
}

/* ===== 分类过渡页 ===== */
.divider-page {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #faf8f5 0%, #f0ebe3 100%);
  position: relative;
}

.divider-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  position: relative;
}

/* 分类页背景纹理 */
.divider-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    radial-gradient(circle at 20% 30%, rgba(201, 168, 108, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(201, 168, 108, 0.1) 0%, transparent 50%);
  pointer-events: none;
}

/* 装饰边框 */
.divider-frame {
  position: absolute;
  top: 60rpx;
  left: 60rpx;
  right: 60rpx;
  bottom: 60rpx;
  pointer-events: none;
}

.frame-corner {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border-color: #c9a86c;
  border-style: solid;
  border-width: 0;
}

.frame-corner.tl {
  top: 0;
  left: 0;
  border-top-width: 2rpx;
  border-left-width: 2rpx;
}

.frame-corner.tr {
  top: 0;
  right: 0;
  border-top-width: 2rpx;
  border-right-width: 2rpx;
}

.frame-corner.bl {
  bottom: 0;
  left: 0;
  border-bottom-width: 2rpx;
  border-left-width: 2rpx;
}

.frame-corner.br {
  bottom: 0;
  right: 0;
  border-bottom-width: 2rpx;
  border-right-width: 2rpx;
}

.divider-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.category-icon {
  font-size: 48rpx;
  color: #c9a86c;
  margin-bottom: 30rpx;
}

.divider-category {
  font-size: 72rpx;
  color: #2a2a3e;
  font-weight: bold;
  letter-spacing: 20rpx;
  margin-bottom: 40rpx;
}

.divider-line {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.line-dot {
  width: 8rpx;
  height: 8rpx;
  background: #c9a86c;
  border-radius: 50%;
}

.line-bar {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #c9a86c, transparent);
  margin: 0 16rpx;
}

.divider-count {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  letter-spacing: 4rpx;
}

.divider-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.8;
  max-width: 480rpx;
  font-style: italic;
}

/* ===== 作品详情页 (Apple Style) ===== */
.work-page {
  background: #faf8f5;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.work-content {
  display: flex;
  flex-direction: column;
  background: #fffcf8;
  height: 100%;
}

/* 底部信息区 */
.work-info-bottom {
  padding: 16rpx 24rpx 12rpx;
  background: #fffcf8;
  flex-shrink: 0;
}

.info-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .info-label {
  font-size: 24rpx;
  color: #86868b;
  width: 110rpx;
  flex-shrink: 0;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.info-row .info-divider-line {
  font-size: 22rpx;
  color: #e5e5e5;
  margin: 0 16rpx;
  flex-shrink: 0;
  font-weight: 200;
}

.info-row .info-value {
  font-size: 26rpx;
  color: #1d1d1f;
  flex: 1;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

/* 作品名称特殊样式 */
.info-row.title-row {
  margin-bottom: 8rpx;
}

.info-row.title-row .info-value {
  font-size: 26rpx;
  color: #1d1d1f;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 学校名称样式 */
.info-row .school-value {
  color: #424245;
}

/* 作品简介样式 */
.info-row.desc-row {
  align-items: flex-start;
  margin-top: 4rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.info-row .desc-value {
  line-height: 1.6;
  color: #424245;
  font-size: 24rpx;
}

/* 作品图片区 */
.work-image-container {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 0;
  min-height: 0;
  position: relative;
  overflow: hidden;
  background: #f5f5f5;
}

.work-image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 0;
  box-shadow: none;
}

/* 底部信息 */
.work-bottom-info {
  padding-top: 8rpx;
  margin-top: 4rpx;
  text-align: center;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.bottom-text {
  font-size: 22rpx;
  color: #86868b;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
  font-weight: 400;
}

/* ===== 尾页 ===== */
.ending-page {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
}

.ending-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
}

.ending-decoration {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.deco-circle {
  width: 60rpx;
  height: 60rpx;
  border: 2rpx solid #c9a86c;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.deco-line {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(180deg, #c9a86c, transparent);
}

.ending-title {
  font-size: 64rpx;
  color: #fff;
  font-weight: 300;
  letter-spacing: 16rpx;
  margin-bottom: 16rpx;
}

.ending-en {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 8rpx;
  margin-bottom: 40rpx;
  font-style: italic;
}

.ending-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.divider-diamond {
  width: 12rpx;
  height: 12rpx;
  background: #c9a86c;
  transform: rotate(45deg);
}

.ending-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 6rpx;
  margin-bottom: 60rpx;
}

.ending-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.ending-org {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.ending-year {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-top: 20rpx;
  letter-spacing: 8rpx;
}

.ending-actions {
  display: flex;
  gap: 40rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.8);
}

.action-btn .btn-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.action-btn .btn-text {
  letter-spacing: 2rpx;
}

.action-btn.share-btn {
  background: linear-gradient(135deg, #c9a86c 0%, #a08050 100%);
  border-color: #c9a86c;
  color: #fff;
}

/* ===== 底部导航栏 ===== */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.8) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

.nav-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  margin: 0 10rpx;
  transition: all 0.3s;
}

.nav-btn:active {
  transform: scale(0.95);
  background: rgba(255,255,255,0.2);
}

.nav-btn.disabled {
  opacity: 0.3;
  pointer-events: none;
}

.nav-icon {
  font-size: 32rpx;
  color: #fff;
}

.nav-progress {
  flex: 1;
  max-width: 300rpx;
  margin: 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.progress-track {
  width: 100%;
  height: 4rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 2rpx;
  position: relative;
  margin-bottom: 10rpx;
}

.progress-thumb {
  position: absolute;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  background: #c9a86c;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: left 0.3s;
  box-shadow: 0 0 10rpx rgba(201, 168, 108, 0.5);
}

.progress-info {
  display: flex;
  align-items: center;
}

.current-page {
  font-size: 28rpx;
  color: #c9a86c;
  font-weight: bold;
}

.page-sep {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  margin: 0 6rpx;
}

.total-pages {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.catalog-btn {
  background: rgba(201, 168, 108, 0.2);
}

/* ===== 目录弹窗 ===== */
.catalog-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 200;
  pointer-events: none;
  transition: background 0.3s;
}

.catalog-modal.show {
  background: rgba(0, 0, 0, 0.6);
  pointer-events: auto;
}

.modal-content {
  width: 100%;
  max-height: 70%;
  background: #faf8f5;
  border-radius: 30rpx 30rpx 0 0;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.catalog-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #e8e4dc;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2a2a3e;
  letter-spacing: 8rpx;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  margin: 20rpx 30rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  border: 1rpx solid #e8e4dc;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

/* 搜索结果 */
.search-results {
  max-height: 500rpx;
  padding: 0 30rpx 20rpx;
}

.search-result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.result-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.result-author {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 无搜索结果 */
.search-empty {
  padding: 60rpx 30rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.modal-body {
  max-height: 600rpx;
  padding: 20rpx 30rpx 40rpx;
}

.catalog-section {
  margin-bottom: 16rpx;
}

.section-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.section-icon {
  font-size: 36rpx;
  color: #c9a86c;
  margin-right: 20rpx;
}

.section-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 30rpx;
  color: #2a2a3e;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.section-desc {
  font-size: 22rpx;
  color: #999;
}

.section-count {
  font-size: 24rpx;
  color: #c9a86c;
  margin-right: 16rpx;
}

.section-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ===== 图片预览 ===== */
.image-preview {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 300;
  pointer-events: none;
  transition: background 0.3s;
}

.image-preview.show {
  background: rgba(0, 0, 0, 0.95);
  pointer-events: auto;
}

.preview-image {
  max-width: 100%;
  max-height: 100%;
  opacity: 0;
  transform: scale(0.9);
  transition: all 0.3s;
}

.image-preview.show .preview-image {
  opacity: 1;
  transform: scale(1);
}

.preview-close {
  position: absolute;
  top: 60rpx;
  right: 40rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
}
