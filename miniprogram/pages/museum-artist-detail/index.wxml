<view class="page artist-page">
  <view wx:if="{{loading}}" class="state" role="status">正在加载艺术家档案…</view>
  <view wx:elif="{{error}}" class="state" role="alert">
    <view>{{error}}</view>
    <button class="more" hover-class="pressed" bindtap="retry">重新加载</button>
  </view>
  <block wx:elif="{{artist}}">
    <view class="profile">
      <view class="profile-name">{{artist.name || '未命名艺术家'}}</view>
      <image wx:if="{{artist.avatar && !avatarFailed}}" class="avatar" src="{{artist.avatar}}" mode="aspectFit" binderror="onAvatarError" aria-label="{{artist.name || '艺术家照片'}}"/>
      <view wx:else class="avatar placeholder">暂无照片</view>
    </view>
    <view class="section profile-section">
      <view class="section-label">艺术家简介</view>
      <view class="intro">{{artist.intro || '暂无简介'}}</view>
    </view>
    <view class="section-title">代表作品</view>
    <view wx:if="{{artist.representativeWorks.length === 0}}" class="meta">暂无公开作品</view>
    <view wx:else class="grid">
      <view wx:for="{{artist.representativeWorks}}" wx:key="viewKey" class="work" data-id="{{item._id}}" data-url="{{item.coverImage}}" bindtap="openCollection" hover-class="{{item._id || item.coverImage ? 'pressed' : 'none'}}" aria-role="{{item._id || item.coverImage ? 'button' : ''}}" aria-label="{{(item._id ? '查看作品：' : '查看作品大图：') + (item.title || '未命名作品')}}">
        <view class="cover-frame">
          <image wx:if="{{item.coverImage && !item.imageFailed}}" class="cover" src="{{item.coverImage}}" mode="aspectFit" lazy-load="{{true}}" data-index="{{index}}" data-url="{{item.coverImage}}" binderror="onWorkImageError" aria-label="{{item.title || '代表作品'}}"/>
          <view wx:else class="cover placeholder">暂无图片</view>
        </view>
        <view class="work-title">{{item.title || '未命名作品'}}</view>
        <view class="meta">{{item.artistName || artist.name || '佚名'}}</view>
      </view>
    </view>
    <button class="text-action related-link" hover-class="pressed" bindtap="showCollections">
      <text>查看关联馆藏</text>
      <view class="arrow-symbol" aria-hidden="true"></view>
    </button>
  </block>
</view>
