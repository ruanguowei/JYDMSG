page {
  min-height: 100%;
  background: #f7f8fa;
}

.page-container {
  min-height: 100vh;
  padding: 32rpx 20rpx 60rpx;
  box-sizing: border-box;
}

.page-heading {
  margin: 0 10rpx 28rpx;
  padding: 36rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.page-kicker,
.page-title,
.page-description {
  display: block;
}

.page-kicker {
  color: #1296db;
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.page-title {
  margin-top: 12rpx;
  color: #333;
  font-size: 40rpx;
  font-weight: 700;
}

.page-description {
  margin-top: 14rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 1.6;
}

.resource-actions {
  display: grid;
  grid-template-columns: repeat(2, 260rpx);
  gap: 24rpx 32rpx;
  justify-content: center;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.resource-action-item {
  width: 260rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 2rpx solid #f0f2f5;
  border-radius: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.06);
}

.resource-action-item:active {
  background: #f5faff;
  transform: scale(0.98);
}

.resource-action-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1296db;
  font-size: 40rpx;
  font-weight: 700;
  border: 2rpx solid rgba(18, 150, 219, 0.28);
  border-radius: 50%;
  box-sizing: border-box;
}

.resource-action-text {
  margin-top: 16rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
}
