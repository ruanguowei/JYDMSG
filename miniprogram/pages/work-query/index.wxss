/* pages/work-query/index.wxss */
.query-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
}

.query-form {
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2d3748;
  text-align: center;
  margin-bottom: 16rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #718096;
  text-align: center;
  margin-bottom: 60rpx;
}

.form-section {
  margin-bottom: 60rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  font-size: 30rpx;
  color: #4a5568;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f7fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #2d3748;
  box-sizing: border-box;
}

.query-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.query-btn[disabled] {
  opacity: 0.6;
}

.tips {
  margin-top: 60rpx;
  padding: 30rpx;
  background: #fff5f0;
  border-radius: 16rpx;
  border-left: 6rpx solid #ed8936;
}

.tips-title {
  font-size: 28rpx;
  color: #c05621;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #7c2d12;
  line-height: 40rpx;
  margin-bottom: 8rpx;
}

/* 查询结果样式 */
.result-container {
  padding-top: 60rpx;
}

.result-card {
  background: white;
  border-radius: 24rpx;
  padding: 80rpx 40rpx 60rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
  text-align: center;
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.result-card.success .result-title {
  color: #38a169;
}

.result-card.fail .result-title {
  color: #718096;
}

.work-info {
  background: #f7fafc;
  border-radius: 16rpx;
  padding: 40rpx;
  margin: 40rpx 0;
  text-align: left;
}

.info-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #718096;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #2d3748;
  font-weight: 500;
}

/* 入围通知图片 */
.notice-images {
  margin: 40rpx 0;
}

.notice-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3748;
  margin-bottom: 20rpx;
  text-align: center;
}

.notice-image {
  width: 100%;
  display: block;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.congrats-text {
  font-size: 28rpx;
  color: #4a5568;
  line-height: 44rpx;
  padding: 0 20rpx;
}

.fail-text {
  font-size: 28rpx;
  color: #718096;
  line-height: 44rpx;
  padding: 0 20rpx;
}

.retry-btn {
  width: 100%;
  height: 88rpx;
  background: white;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin-top: 40rpx;
}

