<!--pages/pottery-submission/index.wxml-->
<view class="container">
  <view class="page-title">全国大学生陶艺作品展报名表</view>

  <view wx:if="{{!agreementAccepted}}" class="consent-gate">
    <view class="consent-badge">填写前请阅读</view>
    <view class="consent-title">参展报名个人信息收集说明</view>
    <view class="consent-paragraph">
      为完成参展资格核验、赛事联系、作品评审、证书制作及作品寄送与退件，我们需要收集你主动填写的身份、联系方式、学校、地址、个人照片及作品资料。
    </view>
    <view class="consent-paragraph">
      相关信息将通过微信云开发提交并存储，仅在上述业务范围内使用。你可以在提交前停止填写；提交后可通过下方联系电话咨询查阅、更正或删除个人信息。
    </view>
    <view class="consent-links">
      <text class="consent-link" catchtap="openUserServiceAgreement">《用户服务协议》</text>
      <text class="consent-divider">和</text>
      <text class="consent-link" catchtap="openPrivacyPolicy">《隐私政策》</text>
    </view>
    <checkbox-group bindchange="handleConsentChange">
      <label class="consent-checkbox-row">
        <checkbox value="accepted" checked="{{consentChecked}}" color="#2f6f62" />
        <text>我已阅读并同意上述协议及信息收集、使用规则</text>
      </label>
    </checkbox-group>
    <button class="consent-start-button" bindtap="confirmConsent" disabled="{{!consentChecked}}">同意并开始填写</button>
    <view class="consent-contact">隐私问题联系电话：15907984066</view>
  </view>

  <form wx:else class="submission-form">
    <view class="consent-confirmed">
      <view class="consent-confirmed-title">已阅读并同意个人信息收集规则</view>
      <view class="consent-confirmed-links">
        <text catchtap="openUserServiceAgreement">用户服务协议</text>
        <text class="consent-confirmed-dot">·</text>
        <text catchtap="openPrivacyPolicy">隐私政策</text>
      </view>
    </view>

    <!-- 个人信息部分 -->
    <view class="form-card">
      <view class="card-title">个人信息</view>
      
      <view class="form-row">
        <view class="form-cell">
          <view class="form-label required">姓名</view>
          <input class="form-input" placeholder="请输入姓名" value="{{name}}" bindinput="inputName"/>
        </view>
        <view class="form-cell">
          <view class="form-label required">性别</view>
          <picker bindchange="bindGenderChange" value="{{genderIndex}}" range="{{genders}}">
            <view class="picker {{gender ? '' : 'placeholder'}}">
              {{gender || '请选择性别'}}
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      
      <view class="form-row">
        <view class="form-cell">
          <view class="form-label required">所在学校</view>
          <input class="form-input" placeholder="请输入学校名称" value="{{school}}" bindinput="inputSchool"/>
        </view>
        <view class="form-cell">
          <view class="form-label required">学校省份</view>
          <picker bindchange="bindSchoolProvinceChange" value="{{schoolProvinceIndex}}" range="{{provinces}}">
            <view class="picker {{schoolProvince ? '' : 'placeholder'}}">
              {{schoolProvince || '请选择省份'}}
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      
      <view class="form-row">
        <view class="form-cell">
          <view class="form-label required">年级</view>
          <picker bindchange="bindGradeChange" value="{{gradeIndex}}" range="{{grades}}">
            <view class="picker {{grade ? '' : 'placeholder'}}">
              {{grade || '请选择年级'}}
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <view class="form-cell">
          <view class="form-label required">出生年月</view>
          <picker mode="date" fields="month" bindchange="bindBirthDateChange" value="{{birthDate}}">
            <view class="picker {{birthDate ? '' : 'placeholder'}}">
              {{birthDate || '请选择出生年月'}}
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      
      <view class="form-row">
        <view class="form-cell">
          <view class="form-label required">专业</view>
          <input class="form-input" placeholder="请输入专业" value="{{major}}" bindinput="inputMajor"/>
        </view>
        <view class="form-cell">
          <view class="form-label required">联系电话</view>
          <input class="form-input" type="number" placeholder="请输入联系电话" value="{{phone}}" bindinput="inputPhone"/>
        </view>
      </view>
      
      <view class="form-group">
        <view class="form-label required">邮箱</view>
        <input class="form-input" placeholder="请输入邮箱" value="{{email}}" bindinput="inputEmail"/>
      </view>
      
      <view class="form-group">
        <view class="form-label required">身份证号码</view>
        <input class="form-input" placeholder="请输入身份证号码" value="{{idNumber}}" bindinput="inputIdNumber"/>
      </view>
      
      <view class="form-row">
        <view class="form-cell">
          <view class="form-label required">指导老师</view>
          <input class="form-input" placeholder="请输入指导老师姓名" value="{{teacher}}" bindinput="inputTeacher"/>
        </view>
        <view class="form-cell">
          <view class="form-label required">指导老师电话</view>
          <input class="form-input" type="number" placeholder="请输入指导老师电话" value="{{teacherPhone}}" bindinput="inputTeacherPhone"/>
        </view>
      </view>
      
      <view class="form-group">
        <view class="form-label required">邮寄地址</view>
        <input class="form-input" placeholder="请输入作品邮寄地址" value="{{address}}" bindinput="inputAddress"/>
        <view class="form-tip">（也是作品退件地址）</view>
      </view>
      
      <view class="form-group">
        <view class="form-label required">个人照片</view>
        <view class="upload-single">
          <view class="upload-preview" wx:if="{{photoUrl}}">
            <image src="{{photoUrl}}" mode="aspectFill"></image>
            <view class="upload-delete" bindtap="removePhoto">×</view>
          </view>
          <view class="upload-button" bindtap="choosePhoto" wx:else>
            <text class="upload-icon">+</text>
            <text class="upload-text">上传照片</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 作品信息部分 -->
    <view class="form-card">
      <view class="card-title">作品信息</view>
      
      <!-- 作品类型选择 -->
      <view class="form-group">
        <view class="form-label required">作品类型</view>
        <picker bindchange="bindWorkTypeChange" value="{{workTypeIndex}}" range="{{workTypes}}">
          <view class="picker {{workType ? '' : 'placeholder'}}">
            {{workTypes[workTypeIndex] || '请选择作品类型'}}
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      
      <view class="form-row">
        <view class="form-cell">
          <view class="form-label required">参展作品名称</view>
          <input class="form-input" placeholder="请输入作品名称" value="{{artworkName}}" bindinput="inputArtworkName"/>
        </view>
        <view class="form-cell">
          <view class="form-label required">创作年份</view>
          <picker mode="date" fields="year" bindchange="bindCreateYearChange" value="{{createYear}}">
            <view class="picker {{createYear ? '' : 'placeholder'}}">
              {{createYear || '请选择创作年份'}}
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      
      <!-- 作品尺寸（仅常规作品） -->
      <view wx:if="{{workType === 'regular'}}" class="form-group">
        <view class="form-label required">作品尺寸 (CM)</view>
        <view class="dimensions-container">
          <block wx:for="{{dimensions}}" wx:key="index">
            <view class="dimension-group">
              <view class="dimension-inputs">
                <input class="dimension-input" type="digit" placeholder="长" value="{{item.length}}" 
                       data-index="{{index}}" data-field="length" bindinput="inputDimension"/>
                <text class="dimension-separator">×</text>
                <input class="dimension-input" type="digit" placeholder="宽" value="{{item.width}}" 
                       data-index="{{index}}" data-field="width" bindinput="inputDimension"/>
                <text class="dimension-separator">×</text>
                <input class="dimension-input" type="digit" placeholder="高" value="{{item.height}}" 
                       data-index="{{index}}" data-field="height" bindinput="inputDimension"/>
              </view>
              <view class="dimension-actions">
                <button class="dimension-btn remove" bindtap="removeDimension" data-index="{{index}}" 
                        wx:if="{{dimensions.length > 1}}">删除</button>
              </view>
            </view>
          </block>
          <button class="dimension-btn add" bindtap="addDimension">+ 添加尺寸组</button>
        </view>
      </view>
      
      <view class="form-group">
        <view class="form-label required">作品类别</view>
        <picker bindchange="bindCategoryChange" value="{{categoryIndex}}" range="{{categories}}">
          <view class="picker {{category ? '' : 'placeholder'}}">
            {{categoryLabel || '请选择作品类别'}}
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
        <view class="category-options">
          <text wx:for="{{categories}}" wx:key="*this" class="category-option">{{item}}</text>
        </view>
      </view>
      
      <!-- 作品工艺、材料（仅常规作品） -->
      <view wx:if="{{workType === 'regular'}}" class="form-group">
        <view class="form-label required">作品工艺、材料</view>
        <textarea class="form-textarea" placeholder="请描述作品的工艺和使用的材料（最多20字）" 
                  value="{{craftMaterial}}" bindinput="inputCraftMaterial" maxlength="20"></textarea>
        <view class="char-count">{{craftMaterial.length}}/20</view>
      </view>
      
      <view class="form-group">
        <view class="form-label required">作品简介（200字以内）</view>
        <textarea class="form-textarea" placeholder="请描述您的作品简介..." value="{{artworkDescription}}"
                  bindinput="inputArtworkDescription" maxlength="200"
                  adjust-position="{{true}}" cursor-spacing="24"></textarea>
        <view class="char-count">{{artworkDescriptionLength}}/200</view>
      </view>
      
      <!-- 常规作品图片上传 -->
      <view wx:if="{{workType === 'regular'}}" class="artwork-upload-section">
        <view class="upload-hero">
          <view class="upload-eyebrow">作品影像档案</view>
          <view class="upload-hero-title">请按指定角度上传 7 张作品照片</view>
          <view class="upload-hero-text">支持真实编码的 JPG/JPEG、PNG；图片必须为 1:1 正方形，单张不超过 5MB。建议尺寸不低于 1200×1200px（建议项，不影响提交）。</view>
        </view>
        <view class="notice-panel">
          请上传作品实拍图。不得使用效果图、渲染图、合成图或 AI 生成图；不添加水印、边框、文字、滤镜或装饰效果。
        </view>
        <view class="image-slot-grid">
          <block wx:for="{{imageSlots}}" wx:key="key">
            <view class="image-slot {{index === 0 ? 'image-slot-featured' : ''}}">
              <view class="image-slot-head"><text>{{item.title}}</text><text class="slot-state">{{item.path ? '已就绪' : '待上传'}}</text></view>
              <view class="image-slot-frame" bindtap="chooseArtworkImage" data-key="{{item.key}}">
                <image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill"></image>
                <view wx:else class="slot-placeholder"><text class="slot-plus">+</text><text>选择图片</text></view>
                <view wx:if="{{item.path}}" class="slot-replace">更换</view>
              </view>
              <view class="image-slot-hint">{{item.hint}}</view>
              <view wx:if="{{item.warning}}" class="slot-warning">{{item.warning}}</view>
              <view wx:if="{{item.path}}" class="slot-remove" bindtap="removeArtworkImage" data-key="{{item.key}}">移除</view>
            </view>
          </block>
        </view>
      </view>
      
      <!-- 特殊陈列方式描述（仅常规作品） -->
      <view wx:if="{{workType === 'regular'}}" class="form-group">
        <view class="form-label">特殊陈列方式描述</view>
        <textarea class="form-textarea" placeholder="请描述特殊陈列方式（选填）" 
                  value="{{specialDisplay}}" bindinput="inputSpecialDisplay"
                  adjust-position="{{true}}" cursor-spacing="24"></textarea>
      </view>
      
      <!-- 视频作品专用字段 -->
      <view wx:if="{{workType === 'video'}}" class="video-work-section">
        <view class="upload-eyebrow">作品展示视频</view>
        <view class="section-title">上传 1 条视频，或使用百度网盘备用提交</view>
        <view class="video-rule-list">
          <text>仅支持 MP4，文件不超过 100MB。</text>
          <text>推荐 720P、约 2.5Mbps、16:9 横屏；时长和分辨率不作限制。</text>
        </view>
        
        <view class="form-group">
          <view class="form-label">站内上传视频（推荐）</view>
          <view wx:if="{{video.fileName}}" class="video-uploader">
            <video wx:if="{{video.tempFilePath || video.fileId}}" class="video-preview" src="{{video.tempFilePath || video.fileId}}" controls></video>
            <view class="video-info">
              <view class="video-status video-status-{{video.uploadStatus}}">
                <text wx:if="{{video.uploadStatus === 'uploading'}}">正在上传：{{videoUploadProgress}}%</text>
                <text wx:elif="{{video.uploadStatus === 'uploaded'}}">视频上传成功</text>
                <text wx:elif="{{video.uploadStatus === 'failed'}}">视频上传失败，可直接重新上传</text>
                <text wx:else>视频检查完成，准备上传</text>
              </view>
            </view>
            <view class="video-action-row">
              <button wx:if="{{video.uploadStatus === 'failed'}}" class="video-retry" bindtap="retryVideoUpload">重新上传</button>
              <button class="video-remove" bindtap="removeVideoFile" disabled="{{videoUploading}}">重新选择</button>
            </view>
          </view>
          <view wx:elif="{{videoChecking}}" class="video-checking">
            <text>正在检查视频格式和大小…</text>
          </view>
          <view wx:else class="video-upload-button" bindtap="chooseVideoFile">
            <text class="upload-icon">+</text>
            <text class="upload-text">选择 MP4 视频</text>
          </view>
          <view wx:if="{{videoUploadHint}}" class="slot-warning">{{videoUploadHint}}</view>
          <view wx:if="{{videoLocalIssue}}" class="video-error">{{videoLocalIssue}}</view>
        </view>
        <view class="baidu-backup">
          <view class="backup-title">视频超过 100MB？</view>
          <view class="backup-text">请优先压缩至 100MB 以内再上传。确实无法压缩时，可确认改用百度网盘提交。</view>
          <button wx:if="{{!useBaiduBackup}}" class="backup-confirm" bindtap="confirmBaiduBackup">确认无法压缩至 100MB 以内</button>
          <view wx:else class="backup-fields">
            <view class="backup-confirmed">已确认使用百度网盘提交</view>
            <input class="form-input" placeholder="百度网盘分享链接" value="{{baiduCloudLink}}" bindinput="inputBaiduCloudLink"/>
            <input class="form-input backup-password" placeholder="提取码（必填）" value="{{baiduCloudPassword}}" bindinput="inputBaiduCloudPassword" maxlength="8"/>
          </view>
        </view>
      </view>
      
      
      <!-- 视频作品注意事项 -->
      <view wx:if="{{workType === 'video'}}" class="upload-tips">
        <text>视频应清晰展示作品整体效果、结构细节、功能展示或创作亮点。</text>
        <text>选择视频后会检查格式和大小并立即上传，请在显示“视频上传成功”前保持页面打开。</text>
      </view>
    </view>
    
    <button class="submit-button" bindtap="submitApplication" disabled="{{submitting || videoUploading || videoChecking}}">提交报名</button>
  </form>

  <view wx:if="{{showPrivacyDialog}}" class="privacy-mask" catchtouchmove="preventDefault">
    <view class="privacy-dialog">
      <view class="privacy-title">隐私保护提示</view>
      <view class="privacy-content">选择作品图片或视频需要读取你主动选中的照片或视频，仅用于本次参展报名与作品评审。</view>
      <view class="privacy-link" bindtap="openPrivacyContract">查看《用户隐私保护指引》</view>
      <view class="privacy-actions">
        <button class="privacy-button privacy-cancel" bindtap="handleRejectPrivacyAuthorization">暂不同意</button>
        <button id="agree-media-privacy" class="privacy-button privacy-agree" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">同意并继续</button>
      </view>
    </view>
  </view>
</view>
