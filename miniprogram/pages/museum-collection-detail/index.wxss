page {
  background: #f6f6f6;
}

.page {
  min-height: 100vh;
}

.state {
  padding: 100rpx 0;
  text-align: center;
  color: #888888;
  font-size: 28rpx;
}

.hero {
  width: 100%;
  height: 520rpx;
  background: #d9d2c3;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7a6a55;
}

.content,
.detail-images {
  margin: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.title {
  color: #1f1f1f;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.artist {
  margin-top: 18rpx;
  color: #8a6a3f;
  font-size: 30rpx;
}

.meta {
  margin-top: 12rpx;
  color: #666666;
  font-size: 26rpx;
}

.section-title {
  margin-top: 32rpx;
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 700;
}

.intro {
  margin-top: 16rpx;
  color: #444444;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.detail-images image {
  width: 100%;
  height: 360rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
}
