<!-- 加载状态 -->
<view wx:if="{{loading}}" class="loading">
  <view class="loading-spinner"></view>
</view>

<!-- 展览横幅 -->
<view class="exhibition-banner">
  <block wx:if="{{exhibition.bannerImageUrl}}">
    <image src="{{exhibition.bannerImageUrl}}" mode="aspectFill"></image>
  </block>
  <block wx:else>
    <view class="banner-placeholder">加载中...</view>
  </block>
</view>

<!-- 大陶展介绍 -->
<view class="exhibition-info">
  <view class="exhibition-title">{{exhibition.title}}</view>
  <view class="exhibition-desc">{{exhibition.description}}</view>
</view>

<!-- 功能按钮 -->
<view class="action-buttons">
  <view class="action-btn {{currentEdition.featureFlags.registration === false ? 'disabled' : ''}}" bindtap="navigateToSubmission">
    <image class="action-icon" src="/images/icons/报名.png" mode="aspectFit"></image>
    <text class="action-text">推荐入口</text>
  </view>
  <view class="action-btn {{currentEdition.featureFlags.registration === false ? 'disabled' : ''}}" bindtap="navigateToInvitation">
    <image class="action-icon" src="/images/icons/推送.png" mode="aspectFit"></image>
    <text class="action-text">邀约入口</text>
  </view>
  <view class="action-btn" bindtap="navigateToQuery">
    <image class="action-icon" src="/images/icons/查询.png" mode="aspectFit"></image>
    <text class="action-text">参展查询</text>
  </view>
  <view class="action-btn {{currentEdition.featureFlags.delivery === false ? 'disabled' : ''}}" bindtap="navigateToDelivery">
    <image class="action-icon" src="/images/icons/运送.png" mode="aspectFit"></image>
    <text class="action-text">作品运送</text>
  </view>
  <view class="action-btn expert-btn {{currentEdition.featureFlags.expertEvaluation === false ? 'disabled' : ''}}" bindtap="navigateToExpertEvaluation">
    <image class="action-icon" src="/images/icons/专家课堂-激活.png" mode="aspectFit"></image>
    <text class="action-text">专家评选</text>
  </view>
  <view class="action-btn {{currentEdition.featureFlags.shortlistedQuery === false ? 'disabled' : ''}}" bindtap="navigateToWorkQuery">
    <image class="action-icon" src="/images/icons/查询.png" mode="aspectFit"></image>
    <text class="action-text">查询入围</text>
  </view>
  <view class="action-btn {{currentEdition.featureFlags.awardQuery === false ? 'disabled' : ''}}" bindtap="navigateToAwardQuery">
    <image class="action-icon" src="/images/icons/查询.png" mode="aspectFit"></image>
    <text class="action-text">获奖查询</text>
  </view>
  <view class="action-btn catalog-btn {{currentEdition.featureFlags.catalog === false ? 'disabled' : ''}}" bindtap="navigateToCatalog">
    <image class="action-icon" src="/images/icons/jar-active.png" mode="aspectFit"></image>
    <text class="action-text">历届作品</text>
  </view>
</view>
