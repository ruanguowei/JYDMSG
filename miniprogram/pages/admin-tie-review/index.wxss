page { background:#f6f7f9; color:#303740; }.tie-page { padding:26rpx 24rpx calc(30rpx + env(safe-area-inset-bottom)); }.intro { color:#66717e; font-size:25rpx; line-height:1.7; margin-bottom:20rpx; }.tie-group { padding:24rpx; margin:20rpx 0; background:white; border-radius:14rpx; }.group-title { font-size:29rpx; font-weight:600; }.quota { color:#0866ff; font-size:24rpx; margin:12rpx 0; }.work-row { display:flex; align-items:center; padding:18rpx 0; border-top:1rpx solid #eee; font-size:27rpx; }.work-row text { display:block; color:#7c8590; font-size:22rpx; margin-top:6rpx; }.work-row checkbox { flex-shrink:0; }.error { color:#b04435; padding:20rpx 0; font-size:26rpx; }.save { background:#0866ff; color:white; margin:24rpx 0; }.message { font-size:26rpx; padding:20rpx; }
