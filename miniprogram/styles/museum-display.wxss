page {
  --museum-bg: #ffffff;
  --museum-ink: #171917;
  --museum-muted: #596059;
  --museum-accent: #814637;
  --museum-line: #d8ddd5;
  --museum-boundary: #828b82;
  --museum-plate: #f6f6f3;
  background: var(--museum-bg);
  color: var(--museum-ink);
  font-family: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  width: 100%;
  padding: 0 40rpx 48px;
  padding-bottom: calc(48px + constant(safe-area-inset-bottom));
  padding-bottom: calc(48px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-width: 720px;
  margin: 0 auto;
  min-height: 100vh;
}

button { color: inherit; }
button::after { border: 0; }
button:focus { outline: 2px solid var(--museum-accent); outline-offset: 2px; }

.module-nav {
  display: flex;
  align-items: stretch;
  border-bottom: 1px solid var(--museum-line);
  margin-bottom: 24px;
  padding-top: 4px;
}

.module-button {
  position: relative;
  box-sizing: border-box;
  background: transparent;
  border-radius: 0;
  margin: 0;
  padding: 0 0 12px;
  width: 56px;
  flex: 0 0 56px;
  min-width: 56px;
  min-height: 56px;
  font-size: 28px;
  font-weight: 400;
  line-height: 1.5;
  color: var(--museum-muted);
}

.module-button.artists-tab { width: 84px; flex-basis: 84px; margin-left: 44px; }

.module-button.active { color: var(--museum-ink); font-weight: 700; }
.module-button.active::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;
  height: 3px;
  background: var(--museum-ink);
}

.search {
  display: flex;
  align-items: center;
  border: 1px solid var(--museum-boundary);
  min-height: 48px;
  margin-bottom: 28px;
  box-sizing: border-box;
}

.search-symbol {
  position: relative;
  width: 14px;
  height: 14px;
  flex: 0 0 14px;
  border: 1.5px solid var(--museum-muted);
  border-radius: 50%;
  margin: 0 14px;
  box-sizing: border-box;
}
.search-symbol::after {
  content: '';
  position: absolute;
  height: 1.5px;
  width: 7px;
  background: var(--museum-muted);
  right: -5px;
  bottom: -2px;
  transform: rotate(45deg);
}

.search input {
  flex: 1;
  min-width: 0;
  height: 48px;
  font-size: 15px;
  line-height: 1.5;
  color: var(--museum-ink);
}
.search-placeholder { color: var(--museum-muted); }
.search-button {
  flex: 0 0 52px;
  min-height: 48px;
  font-size: 15px;
  line-height: 48px;
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 0;
}

.pressed { opacity: .65; }
.context-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: -4px 0 24px;
}
.context-title { flex: 1; min-width: 0; font-size: 16px; line-height: 1.6; word-break: break-all; }
.context-action { flex-shrink: 0; padding: 0 8px; margin: 0; font-size: 14px; min-height: 48px; line-height: 48px; background: transparent; color: var(--museum-accent); }

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px 24rpx;
}
.work { min-width: 0; display: flex; flex-direction: column; }
.cover-frame {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 124.852%;
  background: var(--museum-plate);
  overflow: hidden;
}
.cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--museum-muted);
  font-size: 14px;
  line-height: 1.6;
  background: var(--museum-plate);
}
.work-title {
  font-family: 'Noto Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 1.5;
  min-height: 54px;
  margin-top: 14px;
  word-break: break-all;
  overflow-wrap: break-word;
  flex: 1;
}
.meta { color: var(--museum-muted); font-size: 14px; line-height: 1.6; margin-top: 8px; word-break: break-all; }

.state {
  text-align: center;
  padding: 48px 16px;
  color: var(--museum-muted);
  font-size: 16px;
  line-height: 1.75;
  word-break: break-all;
}
.state.compact { padding: 32px 0 0; }
.more {
  margin: 32px 0 0;
  min-height: 48px;
  padding: 8px 16px;
  font-size: 16px;
  line-height: 1.75;
  background: transparent;
  border: 1px solid var(--museum-boundary);
  color: var(--museum-accent);
  border-radius: 0;
}
.more[disabled] { color: var(--museum-muted); background: var(--museum-plate); }
.state .more { max-width: 280px; margin: 16px auto 0; }
.end-note { text-align: center; color: var(--museum-muted); font-size: 14px; padding: 32px 0 0; }

.skeleton { background: var(--museum-plate); }
.skeleton-line { height: 16px; margin: 14px 0 0; width: 75%; background: var(--museum-plate); }
.skeleton-line.short { width: 48%; height: 14px; }
.loading-label { text-align: center; color: var(--museum-muted); font-size: 14px; margin-top: 24px; }

.artist-row {
  display: flex;
  align-items: flex-start;
  gap: 24px;
  padding-bottom: 24px;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--museum-line);
}
.artist-row:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
.artist-info { flex: 1; min-width: 0; }
.avatar {
  flex: 0 0 92px;
  width: 92px;
  height: 122.6667px;
  background: var(--museum-plate);
  display: block;
}
.avatar.placeholder { display: flex; }
.artist-name {
  font-family: 'Noto Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 24px;
  line-height: 1.5;
  margin: 8px 0 16px;
  word-break: break-all;
}
.intro { font-size: 17px; line-height: 1.75; white-space: pre-wrap; word-break: break-all; overflow-wrap: break-word; }
.excerpt {
  font-size: 15px;
  line-height: 1.65;
  color: var(--museum-muted);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.collection-page { padding-top: 0; }
.hero-wrap {
  position: relative;
  margin: 0 -40rpx;
  background: var(--museum-plate);
  overflow: hidden;
}
.hero { width: 100%; height: 808rpx; max-height: 540px; display: block; background: var(--museum-plate); }
.hero.placeholder { display: flex; }
.counter {
  position: absolute;
  right: 20px;
  bottom: 16px;
  background: var(--museum-bg);
  color: var(--museum-ink);
  padding: 6px 12px;
  font-size: 14px;
  line-height: 1.5;
}
.image-controls { display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin: 8px 0 24px; }
.image-step {
  margin: 0;
  min-width: 48px;
  min-height: 48px;
  padding: 0 12px;
  font-size: 14px;
  line-height: 48px;
  background: transparent;
  border-radius: 0;
}
.image-step[disabled] { color: var(--museum-muted); background: var(--museum-plate); }
.text-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 48px;
  font-size: 15px;
  line-height: 1.6;
  color: var(--museum-accent);
  background: transparent;
  margin: 0;
  padding: 8px 0;
  border-radius: 0;
  box-sizing: border-box;
}
.image-action { margin-left: auto; min-width: 104px; }
.heading {
  font-family: 'Noto Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 34px;
  line-height: 1.45;
  font-weight: 400;
  margin: 24px 0 24px;
  word-break: break-all;
  overflow-wrap: break-word;
}
.author {
  box-sizing: border-box;
  width: 100%;
  display: flex;
  align-items: center;
  min-height: 64px;
  gap: 16px;
  padding: 8px 0;
  margin: 0;
  font-size: 16px;
  line-height: 1.6;
  color: var(--museum-muted);
  text-align: left;
  background: transparent;
  border-radius: 0;
}
.author.link { color: var(--museum-accent); }
.author-photo { width: 36px; height: 48px; flex-shrink: 0; background: var(--museum-plate); }
.author-name { flex: 1; min-width: 0; word-break: break-all; }
.author-initial { font-size: 18px; }
.arrow-symbol { position: relative; display: inline-block; width: 20px; height: 20px; flex: 0 0 20px; }
.arrow-symbol::before { content: ''; position: absolute; top: 9px; left: 1px; width: 16px; height: 1.5px; background: currentColor; }
.arrow-symbol::after { content: ''; position: absolute; top: 5px; right: 2px; width: 8px; height: 8px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); }
.section { margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--museum-line); }
.section-label { color: var(--museum-muted); font-size: 15px; line-height: 1.6; margin-bottom: 16px; }
.section-title {
  font-family: 'Noto Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 26px;
  font-weight: 400;
  line-height: 1.5;
  margin: 40px 0 24px;
}

.artist-page { padding-top: 24px; }
.profile { display: flex; align-items: center; gap: 24px; }
.profile-name {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-family: 'Noto Serif SC', 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 38px;
  font-weight: 400;
  line-height: 1.5;
  word-break: break-all;
}
.profile .avatar { width: 144px; height: 192px; flex-basis: 144px; }
.profile-section { margin-top: 36px; padding-top: 36px; }
.related-link { width: 100%; margin-top: 32px; padding-top: 16px; padding-bottom: 16px; border-top: 1px solid var(--museum-line); min-height: 64px; text-align: left; }

@media (min-width: 600px) {
  .page { padding-left: 32px; padding-right: 32px; }
  .hero-wrap { margin-left: -32px; margin-right: -32px; }
  .grid { gap: 32px 24px; }
  .hero { height: 480px; }
  .artist-row { gap: 32px; }
  .intro { max-width: 600px; }
}
